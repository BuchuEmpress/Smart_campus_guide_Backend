# ============================================================================
# SMART CAMPUS GUIDE - ENVIRONMENT VARIABLES
# ============================================================================

# AI Services
# ----------------------------------------------------------------------------
# Get your Gemini API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended model for cost-effective performance (e.g., gemini-2.5-flash).
# If left blank, the service uses a hardcoded default.
# GEMINI_MODEL_NAME=

# NOTE: OpenStreetMap APIs are FREE and need NO API KEYS! 🎉
# No Google Maps key needed!

# Qdrant Vector Database
# ----------------------------------------------------------------------------
# Retrieve connection details from your Qdrant Cloud dashboard.
QDRANT_HOST=your-cluster-url.qdrant.io
QDRANT_PORT=6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=campus_locations

# MongoDB Database
# ----------------------------------------------------------------------------
# Use your connection string from MongoDB Atlas.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# FastAPI Configuration
# ----------------------------------------------------------------------------
# Standard configuration for running the application server.
API_HOST=0.0.0.0
API_PORT=8000
DEBUG_MODE=True

# Rate Limiting
# ----------------------------------------------------------------------------
# Maximum requests allowed per minute per client.
RATE_LIMIT_PER_MINUTE=60

# Logging
# ----------------------------------------------------------------------------
# Defines the minimum severity level to log (e.g., INFO, DEBUG, WARNING).
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# CORS (Frontend URLs - comma-separated)
# ----------------------------------------------------------------------------
# List of frontend URLs allowed to access the API.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# env.example

# Campus Configuration
# ----------------------------------------------------------------------------
# Geographical boundaries and name for context and validation.
CAMPUS_NAME=University of Bamenda
CAMPUS_BOUNDS_NORTH=6.02
CAMPUS_BOUNDS_SOUTH=6.00
CAMPUS_BOUNDS_EAST=10.27
CAMPUS_BOUNDS_WEST=10.25